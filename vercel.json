{
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "functions": {
    "api/telegram-webhook.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/telegram-webhook",
      "schedule": "0 9 * * 0,1,2,3,4"
    },
    {
      "path": "/api/telegram-webhook?job=cleanup-parties",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/calendar",
      "destination": "/calendar.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/event",
      "destination": "/event.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/swingers-parties",
      "destination": "/swingers-parties.html"
    },
    {
      "source": "/bdsm-parties",
      "destination": "/bdsm-parties.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/liberal-suite",
      "destination": "/liberal-suite.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "redirects": [
