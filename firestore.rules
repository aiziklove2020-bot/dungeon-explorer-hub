rules_version = '2';
// TBDSM Firestore rules.
//
// Threat model notes:
// - This codebase does not yet use Firebase Auth, so request.auth is null on
//   all client calls. Until the Firebase Auth migration (Phase 1.2 of the
//   security plan) lands, ownership cannot be enforced server-side and these
//   rules can only enforce STRUCTURAL validation (shape, length, immutability
//   of identity fields, deny-deletes, restricted update masks).
// - Cloud Functions (functions/) re-sanitize HTML on forum/blog writes; client
//   uses DOMPurify. Keep both layers.
// - Once Firebase Auth + custom claims ship, replace `clientWritable()` and the
//   per-collection `allow write` rules with `isOwner()` / `isAdmin()` checks.
// - Mitigation in place at the API layer (Phase 0 of the security plan):
//     * Admin-only Vercel routes (publish, import, git-history, support-send,
//       support-chat-diagnostic) require `Authorization: Bearer ${ADMIN_API_SECRET}`
//       — see lib/apiAuth.js.
//     * Telegram webhook verifies `X-Telegram-Bot-Api-Secret-Token` against
//       `TELEGRAM_WEBHOOK_SECRET` when configured.
//   These do NOT cover client-direct Firestore writes (forum/blog/store/
//   registrations/support-chat). That gap is closed by Phase 1.2 (Firebase Auth).
//
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function isString(field) {
      return request.resource.data[field] is string;
    }
    function maxLen(field, len) {
      return request.resource.data[field].size() <= len;
    }
    function isNonEmpty(field) {
      return request.resource.data[field] is string
             && request.resource.data[field].size() > 0;
    }
    function affectedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    // Future-ready (no-op while Firebase Auth is not adopted):
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // A client write to `users` may still set `level`/`subscriptions` (the
    // public registration flow auto-grants a hardcoded 'year' tier to new
    // female registrants with no admin involved — see
    // createUserFromRegistration in src/firebase/users.js), but never to the
    // two privileged states admins grant deliberately: 'admin' level or a
    // 'gold' (unlimited) tier. Those still need a real admin action; without
    // this, anyone could updateDoc their own user doc straight to
    // level:'admin' or a permanent gold subscription, the same class of bug
    // fixed for isAdmin/password below.
    function safeLevelUpdate() {
      return !('level' in request.resource.data) || request.resource.data.level != 'admin';
    }
    function safeSubscriptionsUpdate() {
      return !('subscriptions' in request.resource.data) ||
        ((!('parties' in request.resource.data.subscriptions)
          || request.resource.data.subscriptions.parties == null
          || request.resource.data.subscriptions.parties.tier != 'gold')
        && (!('exchangeParties' in request.resource.data.subscriptions)
          || request.resource.data.subscriptions.exchangeParties == null
          || request.resource.data.subscriptions.exchangeParties.tier != 'gold'));
    }
    // functions/issueForumChatToken.js reads forumUsers/{id}.linkedUserId and,
    // if the linked users/{id} doc has isAdmin==true or level=='admin', mints
    // a chatGlobalMod custom claim for that forum account. Without this
    // check, any forum account could self-link (via the public
    // linkForumUserToSiteUser auto-link flow) to an admin's site-user id it
    // merely knows/guesses and inherit global chat-moderator powers with no
    // real relationship between the two accounts. get() here reads a
    // different collection during this write's own authorization check,
    // which is allowed to bypass that target document's rules.
    function targetUserIsAdmin(uid) {
      return uid != null &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        (get(/databases/$(database)/documents/users/$(uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(uid)).data.level == 'admin');
    }

    // Default-deny is implicit; explicitly listed collections only.

    // ── Parties (CMS-managed) ───────────────────────────────────────────
    // TODO(auth): restrict to isAdmin() once auth migration is complete.
    // Can't do that today without breaking a real, live feature: approved
    // advertisers self-serve create/edit/delete their OWN parties directly
    // from the public site (see site-bridge.ts createAdvertiserParty/
    // updateAdvertiserParty/deleteAdvertiserParty), and there is no real
    // per-advertiser auth token anywhere in this app to verify a caller's
    // claimed identity against — the ownership check those functions do
    // (`party.createdBy === advertiserId`) only runs in client JS, which
    // can't be trusted at the rule layer without a way to know who's
    // actually asking. So this rule can only add STRUCTURAL validation
    // (reject obviously malformed/oversized writes, stop an existing
    // party's ownership from being silently reassigned) — it cannot stop
    // one advertiser (or anyone) from editing or deleting a DIFFERENT
    // party than their own, since that genuinely requires the Firebase
    // Auth migration this whole file has been waiting on throughout.
    function safePartyShape() {
      return (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 200))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 5000))
        && (!('registrations' in request.resource.data) || (request.resource.data.registrations is list && request.resource.data.registrations.size() <= 500));
    }
    match /parties/{partyId} {
      allow read: if true;
      allow create: if safePartyShape()
                    && (!('createdBy' in request.resource.data) || request.resource.data.createdBy is string);
      // `createdBy` is pinned once set, so a party can't be silently
      // reassigned to a different advertiser's ownership by a write that
      // isn't itself the owning advertiser (which, again, this rule can't
      // verify — but at least the *recorded* owner can't be swapped out
      // from under them after the fact).
      allow update: if safePartyShape()
                    && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if true;
    }

    // ── Settings ────────────────────────────────────────────────────────
    // PUBLIC settings (theme, public flags) — readable by anyone.
    // Writes go through api/admin-settings.js (Admin SDK + ADMIN_API_SECRET)
    // instead of the client SDK now — this used to be `write: if true`, which
    // meant anyone with the public Firestore config (necessarily embedded in
    // every page) could write arbitrary content straight into fields the
    // public site renders (about/contact copy, social links, Telegram
    // config), bypassing the admin panel and any escaping entirely. There is
    // still no real Firebase Auth in this app, so `isAdmin()` below can't
    // actually be satisfied by anyone — that's intentional here: it's already
    // effectively `write: if false` for the client SDK, with the API route as
    // the one deliberate exception.
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // PRIVATE settings (tokens, secrets) — never returned to clients.
    // The app must move bot tokens / API keys here and read them only from
    // Cloud Functions / server using Admin SDK (which bypasses these rules).
    match /settings/private/{document=**} {
      allow read, write: if false;
    }

    // ── Registrations ───────────────────────────────────────────────────
    match /registrations/{docId} {
      // PII (phone + name). Open read only until auth lands.
      // TODO(auth): restrict to isAdmin() and the registrant.
      allow read: if true;
      allow create: if hasAll(['regType', 'selectedParties'])
                    && request.resource.data.selectedParties is list
                    && request.resource.data.selectedParties.size() <= 50;
      // Updates limited to admin status fields; no field-deletion.
      allow update: if affectedOnly(['status', 'notes', 'updatedAt', 'cancelled']);
      allow delete: if false;
    }

    // The site's admin-login system stores a bcrypt password hash on this
    // same collection (isAdmin/adminUsername/password/isDefaultAdmin), right
    // alongside every regular subscriber. This used to be
    // `allow read, write: if true` — the worst hole found in this whole
    // audit: any visitor could open devtools and run
    // `updateDoc(doc(db,'users','<their own id>'), { isAdmin: true })` to
    // grant themselves full admin-panel access with no password at all, or
    // pull every admin's bcrypt hash for offline brute-forcing (the login
    // check used to run bcrypt.compare in the browser, which only works if
    // the hash is client-readable).
    //
    // Fix, without a data migration that could lock the real admin out:
    //   - `allow read` denies any doc where `isAdmin == true` outright — the
    //     overwhelming majority of docs (regular subscribers) stay readable,
    //     since huge parts of the app (subscription checks, CRM, forum
    //     linking) read this collection directly and none of that is
    //     admin-sensitive. Admin-account reads now go through
    //     api/admin-settings.js (Admin SDK, bypasses this rule entirely).
    //   - `allow create/update` deny touching isAdmin/isDefaultAdmin/
    //     adminUsername/password at all — every legitimate write to those
    //     fields (login's bcrypt auto-upgrade, promote/demote, password
    //     reset) now goes through that same API. No other client write path
    //     in this codebase ever touches these four fields (verified against
    //     every setDoc/updateDoc call on this collection).
    //   - `allow delete` was implicitly allowed by the old `write: if true`
    //     but nothing in the app ever deletes a user doc from the client —
    //     denied outright rather than left open.
    // `crm` (acquisition source + manual payment log, see src/firebase/crm.js)
    // is admin-only data with no legitimate client write path at all — denied
    // outright rather than field-validated, same reasoning as isAdmin/password
    // above. Before this, any visitor could updateDoc their own (or anyone's)
    // `crm.payments` array to forge/delete "paid" records the admin panel
    // trusts as real sales history.
    match /users/{userId} {
      allow read: if resource.data.isAdmin != true;
      allow create: if !request.resource.data.keys().hasAny(['isAdmin', 'isDefaultAdmin', 'adminUsername', 'password', 'crm'])
                    && safeLevelUpdate() && safeSubscriptionsUpdate();
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isDefaultAdmin', 'adminUsername', 'password', 'crm'])
                    && safeLevelUpdate() && safeSubscriptionsUpdate();
      allow delete: if false;
    }

    // ── Subscription requests (public "I want to subscribe" form) ──────
    // No PII beyond name + phone; admin reviews the queue in "ניהול מנויים".
    match /subscriptionRequests/{docId} {
      allow read: if true;
      // TODO(auth): restrict to isAdmin().
      allow create: if hasAll(['fullName', 'phoneNumber', 'status'])
                    && isNonEmpty('fullName') && maxLen('fullName', 100)
                    && isNonEmpty('phoneNumber') && maxLen('phoneNumber', 20)
                    && request.resource.data.status == 'pending';
      allow update: if affectedOnly(['status', 'resolvedAt']);
      // TODO(auth): restrict to isAdmin() — matches the same trust level as
      // create/update above (admin panel uses a shared secret, not per-user
      // auth, elsewhere in this codebase).
      allow delete: if true;
    }

    // ── Web Push subscriptions (balance-match / party alerts to mobile) ─
    match /pushSubscriptions/{docId} {
      allow read: if true;
      // doc id is derived from the endpoint, so re-subscribing the same
      // device is a Firestore "update" (doc already exists), not "create".
      allow create, update: if hasAll(['phone', 'endpoint'])
                    && isNonEmpty('phone') && maxLen('phone', 20)
                    && isNonEmpty('endpoint') && maxLen('endpoint', 500);
      allow delete: if true;
    }

    // ── Advertisers (self-signup, admin-approved) ──────────────────────
    // Contains a bcrypt password hash. Writes go through api/advertiser-auth.js
    // now (Admin SDK) instead of the client SDK — this used to be
    // `allow read, write: if true`, which let anyone read every advertiser's
    // phone + password hash directly (offline brute-force) or write a doc
    // with `status: 'approved'` themselves, bypassing admin approval
    // entirely. isAdmin() can't actually be satisfied by any client today
    // (no Firebase Auth), so this is effectively `if false` for the
    // browser, with the API route as the one deliberate exception.
    match /advertisers/{docId} {
      allow read, write: if isAdmin();
    }

    // Writes go through api/admin-settings.js now (see the comment on
    // /settings/{document} above for why this app can't just use
    // isAdmin() yet). Feed text renders through React (auto-escaped), so
    // this isn't an XSS vector the way /settings was, but it was still
    // fully open to anonymous writes with no validation at all.
    match /rssFeeds/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Logging collections ─────────────────────────────────────────────
    match /webhookLogs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    match /dbReadLogs/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // ── Store (feature removed from the app — see git history) ──────────
    // No UI reads or writes these anymore, but the Firestore project config
    // is public (embedded in every page), so anyone could still hit these
    // collections directly via the SDK/REST API while the rules stayed
    // open — unlimited free-form writes here is a storage/billing abuse
    // vector with zero product benefit. Denied outright rather than left
    // open "just in case"; restore real rules if the feature ever returns.
    match /storeProducts/{docId} {
      allow read, write: if false;
    }

    match /storeOrders/{docId} {
      allow read, write: if false;
    }

    // ── Workshops (feature removed from the app — see git history) ──────
    // Same reasoning as Store above.
    match /workshops/{workshopId} {
      allow read, write: if false;
    }

    match /workshopRegistrations/{docId} {
      allow read, write: if false;
    }

    // ── Leads (public "רוצה להיות מנוי?" banner submissions) ─────────────
    match /leads/{docId} {
      allow read: if true;
      allow create: if hasAll(['name', 'phone', 'track', 'status', 'createdAt'])
                    && isNonEmpty('name') && maxLen('name', 120)
                    && isString('phone') && maxLen('phone', 20)
                    && request.resource.data.track in ['parties', 'exchange', 'combo']
                    && request.resource.data.status == 'new';
      // TODO(auth): restrict update/delete to isAdmin() once auth migration is complete.
      allow update: if affectedOnly(['status', 'updatedAt']);
      allow delete: if true;
    }

    // ── Support chat ────────────────────────────────────────────────────
    // sessionId is a client-generated UUID; treat it as a capability token.
    match /supportChat/{sessionId} {
      allow read, write: if true;
    }
    match /supportChat/{sessionId}/messages/{messageId} {
      allow read: if true;
      allow create: if hasAll(['text', 'createdAt'])
                    && isString('text')
                    && maxLen('text', 4000);
      allow update: if false;
      // deleteSupportChatSession() (src/firebase/supportChat.js) deletes
      // every message doc in a session ("delete chat" in the admin panel).
      // Not wired to any UI yet, but `delete: if false` here would reject
      // the very first message delete the moment it is — matches the
      // same trust level as the parent supportChat doc above.
      // TODO(auth): restrict to isAdmin() once auth migration ships.
      allow delete: if true;
    }
    match /supportChatTelegramMap/{docId} {
      // TODO(auth): server-only via Admin SDK.
      allow read, write: if true;
    }

    match /deleteRequests/{docId} {
      // submitDeleteRequest() (src/firebase/deleteRequests.js) writes
      // {phoneNumber, status, createdAt} — there is no userId field on this
      // collection and never has been (DeleteRequestsSection.jsx reads
      // r.phoneNumber). The rule previously required 'userId', which no
      // real write ever set, so every submission was rejected with
      // permission-denied — the account-deletion request form was
      // completely broken in production.
      allow create: if hasAll(['phoneNumber', 'createdAt'])
                    && isNonEmpty('phoneNumber') && maxLen('phoneNumber', 20);
      allow read: if true;
      allow update: if affectedOnly(['status', 'processedAt', 'notes']);
      allow delete: if false;
    }

    // ── Forum ───────────────────────────────────────────────────────────
    // No code anywhere in this repo reads or writes this collection (the
    // forum has no category-management UI) — same reasoning as the
    // Store/Workshops/live-chat collections above: an open write rule on a
    // dead collection is still a live abuse vector since the Firestore
    // config is public. Denied outright.
    match /forumSections/{docId} {
      allow read, write: if false;
    }

    // forumTopics/forumReplies: no code anywhere in this repo reads or
    // writes either collection (this old-style forum — sections/topics/
    // replies — was superseded by the live chat + blog comments). Their
    // rules previously allowed unrestricted `delete: if true` (anyone could
    // wipe any topic/reply, not just its author or an admin) on top of
    // being otherwise unused — same reasoning as forumSections above.
    // Denied outright.
    match /forumTopics/{docId} {
      allow read, write: if false;
    }

    match /forumReplies/{docId} {
      allow read, write: if false;
    }

    match /forumUsers/{docId} {
      // Public read exposes hashed passwords. TODO(auth): replace with Firebase Auth.
      allow read: if true;
      // A create can set role/isBlocked/isApproved (registerForumUser does,
      // to 'user'/false/false) but never to a privileged/bypassing value —
      // otherwise the update rule's protection below could be sidestepped
      // entirely by just creating the doc already-privileged.
      allow create: if hasAll(['nickname', 'password'])
                    && isNonEmpty('nickname')
                    && maxLen('nickname', 30)
                    && isNonEmpty('password')
                    && (!('role' in request.resource.data) || request.resource.data.role == 'user')
                    && (!('isBlocked' in request.resource.data) || request.resource.data.isBlocked == false)
                    && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false);
      // Identity fields must not change post-create; password change limited.
      // `nicknameLower` is denormalized from `nickname` for case-insensitive
      // lookup and must stay pinned in lockstep with it (legacy docs without
      // `nicknameLower` may have it written exactly once on first login).
      // Email fields can be set/changed by the owning client, but the client
      // must never FLIP `emailVerified` from false → true. Only the API
      // endpoints (admin SDK, which bypasses rules) can mark an address as
      // verified. We compare against `resource.data` so a partial update
      // (e.g. profile bio edit) doesn't fail just because the post-write
      // doc still carries the existing `emailVerified == true`.
      // `role` and `isBlocked` used to have NO protection at all here — any
      // forum account could self-promote via a plain client updateDoc (e.g.
      // {role: 'forumAdmin'}, which functions/issueForumChatToken.js reads
      // to grant chatGlobalMod over the live chat), or clear its own block.
      // `isApproved` gates whether a new signup can log in at all
      // (loginForumUser) and had the same gap. All three are now pinned to
      // their existing value, same treatment as emailVerified below — only
      // api/forum-auth.js's admin-set-role/-blocked/-approved actions
      // (Admin SDK) can change them.
      allow update: if request.resource.data.nickname == resource.data.nickname
                    && (!('nicknameLower' in request.resource.data)
                        || !('nicknameLower' in resource.data)
                        || request.resource.data.nicknameLower == resource.data.nicknameLower)
                    && (
                         !('emailVerified' in request.resource.data)
                         || request.resource.data.emailVerified == false
                         || (
                              'emailVerified' in resource.data
                              && resource.data.emailVerified == true
                              && request.resource.data.emailVerified == true
                            )
                       )
                    && (!('createdAt' in request.resource.data)
                        || request.resource.data.createdAt == resource.data.createdAt)
                    && (!('role' in request.resource.data)
                        || !('role' in resource.data)
                        || request.resource.data.role == resource.data.role)
                    && (!('isBlocked' in request.resource.data)
                        || !('isBlocked' in resource.data)
                        || request.resource.data.isBlocked == resource.data.isBlocked)
                    && (!('isApproved' in request.resource.data)
                        || !('isApproved' in resource.data)
                        || request.resource.data.isApproved == resource.data.isApproved)
                    // linkForumUserToSiteUser (the public self-link flow) may
                    // still set linkedUserId to any regular site-user id, but
                    // never to one belonging to an admin — see
                    // targetUserIsAdmin() above.
                    && (!('linkedUserId' in request.resource.data)
                        || request.resource.data.linkedUserId == resource.data.get('linkedUserId', null)
                        || !targetUserIsAdmin(request.resource.data.linkedUserId));
      // Forum user deletion is admin-driven from the Users tab. Until Firebase
      // Auth + custom claims land we can't enforce isAdmin() at the rule
      // layer, so this matches the existing pattern used for other
      // admin-mutating collections (e.g. blogPosts/forumPosts allow delete).
      // TODO(auth): restrict to isAdmin() once Firebase Auth migration ships.
      allow delete: if true;
    }

    // Password-reset, email-verification tokens, and the per-key throttle
    // bookkeeping doc are all server-only (admin SDK). Clients must never
    // read or write these. Default-deny would already cover this, but make
    // it explicit so future blanket "writes for forumUsers" changes don't
    // accidentally open the doors.
    match /forumPasswordResets/{docId} {
      allow read, write: if false;
    }
    match /forumEmailTokens/{docId} {
      allow read, write: if false;
    }
    match /forumAuthThrottle/{docId} {
      allow read, write: if false;
    }

    // A logged-in forum user's saved/favorited parties. Same trust model as
    // forumUsers above (no Firebase Auth yet, so the client's claimed userId
    // can't be verified at the rule layer — matches the existing pattern
    // until the Firebase Auth migration lands).
    match /favorites/{favId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'partyId']) && isNonEmpty('userId') && isNonEmpty('partyId');
      allow update: if false;
      allow delete: if true;
    }

    // ── Blog ────────────────────────────────────────────────────────────
    match /blogPosts/{docId} {
      allow read: if true;
      allow create: if hasAll(['title', 'content', 'authorId', 'authorName'])
                    && isNonEmpty('title')
                    && maxLen('title', 200)
                    && maxLen('content', 50000)
                    && isString('authorId');
      allow update: if request.resource.data.authorId == resource.data.authorId
                    && (!('content' in request.resource.data) || request.resource.data.content.size() <= 50000)
                    && (!('title' in request.resource.data) || request.resource.data.title.size() <= 200);
      // TODO(auth): restrict to isAdmin() or author.
      allow delete: if true;
    }

    match /blogComments/{docId} {
      allow read: if true;
      allow create: if hasAll(['postId', 'content', 'authorId'])
                    && isNonEmpty('content')
                    && maxLen('content', 5000)
                    && isString('authorId');
      allow update: if request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.postId == resource.data.postId
                    && (!('content' in request.resource.data) || request.resource.data.content.size() <= 5000);
      allow delete: if true;
    }

    match /blogAuthorFollows/{docId} {
      allow read: if true;
      allow create: if hasAll(['followerId', 'authorId'])
                    && isString('followerId')
                    && isString('authorId');
      // markBlogAuthorSeen() (src/firebase/blog.js) updates lastSeenAt on an
      // existing follow doc to clear the "new posts from this author"
      // badge — that's a real, load-bearing update, not "no updates
      // needed" as the previous comment (and `if false` rule) claimed.
      // Every click of "mark as read" was rejected with permission-denied.
      allow update: if affectedOnly(['lastSeenAt']);
      allow delete: if true;
    }

    // ── Bookmarks ───────────────────────────────────────────────────────
    match /bookmarks/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'itemType', 'itemId'])
                    && isString('userId')
                    && isString('itemId')
                    && (request.resource.data.itemType == 'topic'
                        || request.resource.data.itemType == 'blogPost');
      allow update: if request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemType == resource.data.itemType
                    && request.resource.data.itemId == resource.data.itemId;
      allow delete: if true;
    }

    // ── Notifications ───────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if true;
      allow create: if hasAll(['userId', 'type', 'read', 'createdAt'])
                    && isString('userId')
                    && request.resource.data.read == false
                    && (!('message' in request.resource.data) || maxLen('message', 200))
                    && (!('refTitle' in request.resource.data) || maxLen('refTitle', 100));
      // Mark-as-read only.
      allow update: if affectedOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // ── Private Messages ────────────────────────────────────────────────
    match /privateMessages/{docId} {
      // TODO(auth): restrict to participants only.
      allow read: if true;
      allow create: if hasAll(['conversationId', 'senderId', 'receiverId', 'content', 'read', 'createdAt'])
                    && isString('senderId')
                    && isString('receiverId')
                    && request.resource.data.senderId != request.resource.data.receiverId
                    && request.resource.data.read == false
                    && maxLen('content', 2000);
      // Mark-as-read only.
      allow update: if affectedOnly(['read'])
                    && request.resource.data.read == true;
      allow delete: if false;
    }

    // ── Conversations (denormalized metadata) ──────────────────────────
    match /conversations/{docId} {
      // TODO(auth): restrict to participants only.
      allow read: if true;
      allow create: if hasAll(['participants', 'lastMessage', 'lastAt', 'lastSenderId'])
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2;
      // Identity-bearing fields immutable; metadata may update.
      allow update: if request.resource.data.participants == resource.data.participants;
      allow delete: if false;
    }

    // ── Live chat (feature removed from the app — see git history) ──────
    // No UI reads or writes any of these collections anymore. They were
    // left at `allow read, write: if true` with zero validation after
    // removal — since the Firestore project config is public, that was a
    // live, unauthenticated write hole (unlimited free-form documents,
    // fabricated mute/report records) with no product using it. Denied
    // outright; restore real rules if the feature is rebuilt.
    match /chatRooms/{roomId} {
      allow read, write: if false;
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read, write: if false;
    }

    match /chatRooms/{roomId}/messages/{messageId}/reactions/{reactionId} {
      allow read, write: if false;
    }

    match /chatRooms/{roomId}/members/{memberId} {
      allow read, write: if false;
    }

    match /chatRooms/{roomId}/typing/{userId} {
      allow read, write: if false;
    }

    match /chatMutes/{userId} {
      allow read, write: if false;
    }

    match /chatMessageReports/{reportId} {
      allow read, write: if false;
    }
  }
}
